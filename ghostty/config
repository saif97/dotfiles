custom-shader = shaders/cursor_blaze_tapered.glsl
# custom-shader = shaders/in-game-crt.glsl
# custom-shader = shaders/retro-terminal2.glsl
# custom-shader = shaders/fallout.glsl

confirm-close-surface = false
quit-after-last-window-closed = false
window-decoration = none
window-padding-y = 0,0
window-padding-x = 0,0
background-opacity = 0
background-blur = macos-glass-regular

# Source: https://gist.github.com/adibhanna/c552c452fb244b3b721e3c2432e85cde
#font-family = Iosevka Nerd Font
# font-family = SFMono Nerd Font 
shell-integration-features = no-cursor,sudo,no-title,ssh-terminfo,ssh-env
cursor-style = block
adjust-cell-height = 5%

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

window-padding-balance = true 
window-save-state = always
macos-titlebar-style=transparent
window-colorspace = "display-p3"
background = 1C2021
# foreground = d4be98

# keybindings

keybind = global:alt+grave_accent=toggle_quick_terminal

keybind = cmd+t=unbind
keybind = cmd+n=unbind
keybind = cmd+w=unbind
keybind = cmd+d=unbind
keybind = cmd+a=unbind
keybind = cmd+s=unbind
keybind = cmd+n=unbind
keybind = ctrl+n=unbind

keybind = cmd+t>r=reload_config
keybind = cmd+t>q=close_surface
keybind = cmd+t>n=new_window

cursor-style = bar

# Quality of life
# sets delete forward a word
keybind = alt+delete=text:\x1b[3;3~ 

# Make shift+backspace distinguishable from plain backspace (nvim <S-BS>).
# Nvim only asks for kitty keyboard flag 1 (CSI > 1 u), and under that flag keys
# with a legacy encoding are still sent legacy when only shift is held — so
# shift+backspace would otherwise arrive as a bare 0x7f, i.e. plain <BS>.
keybind = shift+backspace=csi:127;2u

macos-option-as-alt = true

# Clipboard
clipboard-read = allow
clipboard-write = allow

notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 30s

