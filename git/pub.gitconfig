# To include this in your global ~/.gitconfig, add:
#   [include]
#       path = ~/dotfiles/git/pub.gitconfig
#
# Or via command line:
#   git config --global include.path ~/dotfiles/git/pub.gitconfig


# Delta setup
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection

[merge]
    conflictStyle = zdiff3
    autoStash = true

[include]
	path = ./catppuccin.gitconfig

[delta]
	features = catppuccin-macchiato

[rebase]
	autoStash = true

[pull]
	rebase = true

[push]
	# push to the tracked upstream branch even when its name differs from
	# the local branch (avoids "upstream branch does not match" fatal)
	default = upstream
	# branches with no upstream yet: create origin/<branch> on first push
	autoSetupRemote = true

[submodule]
	recurse = true
